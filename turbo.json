{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".expo/**",
        "android/app/build/**",
        "ios/build/**"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "SUPABASE_SERVICE_ROLE_KEY", "SYNC_SECRET", "GEMINI_API_KEY", "GOOGLE_SHEETS_ID", "GOOGLE_SERVICE_ACCOUNT_JSON"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
