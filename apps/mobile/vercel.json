{
  "buildCommand": "npx expo export -p web && cp dist/+not-found.html dist/404.html",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @iskotify/mobile...",
  "framework": null,
  "cleanUrls": true,
  "git": { "deploymentEnabled": { "master": true, "**": false } },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../../packages ../../pnpm-lock.yaml ../../package.json",
  "rewrites": [
    { "source": "/auth/sign-in", "destination": "/auth/sign-in" },
    { "source": "/auth/callback", "destination": "/auth/callback" },
    { "source": "/auth/reset-password", "destination": "/auth/reset-password" },
    { "source": "/subjects/:id", "destination": "/subjects/[id]" },
    { "source": "/career/:courseId", "destination": "/career/[courseId]" },
    { "source": "/career/country/:code", "destination": "/career/country/[code]" },
    { "source": "/listings/:slug", "destination": "/listings/[slug]" },
    { "source": "/notes/:id", "destination": "/notes/[id]" },
    { "source": "/practice/deck/:deckId", "destination": "/practice/deck/[deckId]" },
    { "source": "/practice/review/:slug", "destination": "/practice/review/[slug]" },
    { "source": "/practice/start/:slug", "destination": "/practice/start/[slug]" },
    { "source": "/practice/exam/:slug", "destination": "/practice/exam/[slug]" },
    { "source": "/practice/upcat/:subtest", "destination": "/practice/upcat/[subtest]" },
    { "source": "/schools/course/:code", "destination": "/schools/course/[code]" },
    { "source": "/schools/:slug", "destination": "/schools/[slug]" },
    { "source": "/practice/:topicId", "destination": "/practice/[topicId]" }
  ],
  "headers": [
    {
      "source": "/(_expo/static|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
