# Public env vars for the mobile app (EXPO_PUBLIC_* are bundled into the build)

# Admin API base URL — used by useSchoolSearch to call the cached Places proxy.
# Falls back to https://iskotify.vercel.app when unset.
EXPO_PUBLIC_ADMIN_BASE_URL=https://iskotify.vercel.app

# PostHog analytics (optional). Analytics is a NO-OP until EXPO_PUBLIC_POSTHOG_KEY
# is set, so the app runs unchanged without it. Set the same two vars in BOTH:
#   • the EAS build env (native app) — eas.json env / EAS dashboard secrets
#   • the web-mirror deploy env (Vercel/host that serves `expo export -p web`)
# Project API key = the "Project API Key" (phc_...) from PostHog → Settings.
# Host = your PostHog cloud region: https://us.i.posthog.com (default) or
#        https://eu.i.posthog.com. Self-hosted → your instance URL.
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Iskotify Full Access (one-time ₱500, no ads, no subscription). OFF unless exactly "1":
# with it off the app behaves as before (no limits, no upgrade screen or prompts anywhere).
# Turn it on only once the server side (entitlements table, checkout + webhooks) is live.
#   • Android buys through Google Play via RevenueCat; web buys through PayMongo
#     (POST ${EXPO_PUBLIC_ADMIN_BASE_URL}/api/payments/checkout). Either unlocks both.
#   • Access is decided ONLY by the server row public.entitlements (premium = true).
# Set in BOTH the EAS build env and the web-mirror deploy env.
EXPO_PUBLIC_PAYWALL_ENABLED=0

# RevenueCat public SDK key for Android (Project → API keys → Google Play, "goog_…").
# Public by design (it ships in the app). Native builds only; the web build never loads RevenueCat.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
