{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "master": true, "**": false } },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../../packages ../../pnpm-lock.yaml ../../package.json",
  "crons": [
    { "path": "/api/kb/drive-sync", "schedule": "0 18 * * *" },
    { "path": "/api/retention/purge", "schedule": "30 19 * * *" }
  ]
}
