# Sync secret — shared between this file and the Google Apps Script
# Generate with: openssl rand -base64 32
SYNC_SECRET=replace-with-a-long-random-string

# Google Sheets
GOOGLE_SHEETS_ID=your-google-sheet-id-here
# Service account JSON — paste the full JSON content as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
# Server-only — never expose this to the client or mobile app
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Gemini AI
GEMINI_API_KEY=        # get free at aistudio.google.com
