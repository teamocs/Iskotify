# Sync secret — shared between this file and the Google Apps Script
# Generate with: openssl rand -base64 32
SYNC_SECRET=replace-with-a-long-random-string

# Google Sheets
GOOGLE_SHEETS_ID=your-google-sheet-id-here
# Service account JSON — paste the full JSON content as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
# Server-only — never expose this to the client or mobile app
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Gemini AI
GEMINI_API_KEY=        # get free at aistudio.google.com

# Upstash Redis (server-only — never expose to client or mobile)
# Get from https://console.upstash.com/redis after creating a free database
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-token-from-upstash-console

# Google Places API — SERVER-SIDE key (separate from mobile's bundle-ID-restricted key)
# Used by /api/places/school-search proxy. Create in Google Cloud Console and lock to
# Vercel egress IPs OR use HTTP referrer https://iskotify.ph/*
GOOGLE_PLACES_SERVER_KEY=AIza...your-server-key...

# Web app URL — deployed Expo Web build (see apps/mobile/README-WEB.md).
# Optional override: the landing "Try on Web" / "Start for free" buttons fall back
# to the hardcoded default in apps/admin/lib/links.ts (https://app.iskotify.ph),
# so they always render. Set this only to point at a different web-app deployment.
NEXT_PUBLIC_WEB_APP_URL=

# Android early-access build URL (APK / Play internal-test link). Falls back to
# NEXT_PUBLIC_WEB_APP_URL when unset (the web app is the trial until an APK exists).
NEXT_PUBLIC_ANDROID_APP_URL=

# ── Early-access APK delivery (Resend) ──────────────────────────────────────
# Sends an approved registrant their 48h signed APK download link from the
# admin "Send APK" button. Create a free account at https://resend.com, verify a
# sending domain (e.g. mail.iskotify.ph), then paste the key here AND in Vercel.
# Server-only — never expose to the client.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The "From" address shown on the email — MUST be on your Resend-verified domain.
EARLY_ACCESS_FROM="Iskotify <early-access@iskotify.ph>"
# Storage object key for the uploaded APK inside the early-access-apk bucket.
# Optional — defaults to iskotify-early-access.apk when unset.
EARLY_ACCESS_APK_OBJECT=iskotify-early-access.apk
