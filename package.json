{
  "name": "iskotify",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@iskotify/admin",
    "dev:mobile": "turbo run dev --filter=@iskotify/mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "scrape-schools": "node scripts/scrape-schools.js"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.5",
      "@expo/metro-runtime": "^6.1.2",
      "react-native-worklets": "0.5.1"
    }
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "xlsx": "^0.18.5"
  }
}
